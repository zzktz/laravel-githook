{
    "name": "zzktz/laravel-githook",
    "description": "Laravel 项目的 Gitee Webhook 安全更新扩展包",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/routing": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "symfony/process": "^5.1|^6.0|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zzktz\\LaravelGithook\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zzktz\\LaravelGithook\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zzktz\\LaravelGithook\\GithookServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
